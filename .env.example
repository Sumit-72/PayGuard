# Environment variable template for PayGuard
#
# Copy this file to .env.local and fill in the actual values.
# Never commit .env or .env.local to version control.
#
# Currently PayGuard operates entirely client-side with mock data.
# These variables are placeholders for future backend/gateway integration.

# ── Razorpay Integration (future) ────────────────────────────
# VITE_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX

# ── PayGuard API (future) ─────────────────────────────────────
# VITE_PAYGUARD_API_URL=https://api.payguard.example.com
# VITE_PAYGUARD_API_KEY=pg_live_XXXXXXXXXXXX

# ── Analytics / Observability (future) ───────────────────────
# VITE_POSTHOG_KEY=phc_XXXXXXXXXXXX
